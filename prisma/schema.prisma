generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id         String   @id @default(uuid())
  supabaseId String   @unique
  role       UserRole @default(USER)

  firstName String  @db.VarChar(50)
  lastName  String  @db.VarChar(50)
  avatarUrl String? @db.VarChar(255)
  bio       String? @db.VarChar(255)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  favorites     Favorite[]
  draftListings DraftListing[]
  reservations  Reservation[]
  listings      Listing[]
  moderations   ListingModeration[]
  reviews       Review[]
}

model Listing {
  id          String        @id @default(uuid())
  title       String
  description String
  nightPrice  Int
  status      ListingStatus @default(PENDING)
  hostId      String
  host        Profile       @relation(fields: [hostId], references: [id], onDelete: Cascade)
  images      String[]
  promotions  Json          @default("[]")

  // Structure
  beds      Int
  bedrooms  Int
  bathrooms Int

  // Guest limits
  maxAdults   Int
  maxChildren Int
  maxInfants  Int
  maxPets     Int

  // Max total guests
  maxGuests Int

  // Ubication
  city     String
  country  String
  lat      Float
  lng      Float
  location Json

  // Reviews
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)
  reviews     Review[]

  checkInTime   String @default("15:00")
  checkOutTime  String @default("11:00")
  minCancelDays Int    @default(3)

  privacyType  PrivacyType         @default(PRIVATE)
  favorites    Favorite[]
  propertyType PropertyType
  amenities    ListingAmenity[]
  reservations Reservation[]
  moderations  ListingModeration[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@index([city])
  @@index([lat, lng])
  @@index([nightPrice])
  @@index([hostId])
}

model DraftListing {
  id String @id @default(uuid())

  // Core
  title       String @default("")
  description String @default("")
  nightPrice  Int    @default(40)

  images       String[] @default([])
  amenities    String[] @default([])
  currentStep  Int      @default(0)
  visitedSteps Int[]    @default([])
  promotions   Json     @default("[]")

  // Structure
  beds      Int @default(0)
  bedrooms  Int @default(0)
  bathrooms Int @default(0)

  // Guest limits
  maxAdults   Int @default(2)
  maxChildren Int @default(0)
  maxInfants  Int @default(0)
  maxPets     Int @default(0)
  maxGuests   Int @default(2)

  // Location
  location Json @default("{}")

  // Rules
  checkInTime   String @default("15:00")
  checkOutTime  String @default("11:00")
  minCancelDays Int    @default(3)

  // Meta
  privacyType  PrivacyType  @default(ENTIRE)
  propertyType PropertyType @default(HOUSE)

  hostId  String
  profile Profile @relation(fields: [hostId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([hostId])
}

model Reservation {
  id        String  @id @default(uuid())
  userId    String?
  listingId String

  startDate DateTime @db.Timestamptz(6)
  endDate   DateTime @db.Timestamptz(6)

  guests Json @default("{}")

  totalPrice         Decimal  @db.Decimal(10, 2)
  totalNights        Int
  nightPrice         Decimal  @db.Decimal(10, 2)
  discount           Decimal? @db.Decimal(10, 2)
  discountPercentage Int?

  status ReservationStatus @default(UPCOMING)

  user    Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)
  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  canceledAt DateTime? @db.Timestamptz(6)

  @@index([listingId])
  @@index([userId])
}

model Amenity {
  id       String          @id @default(uuid())
  name     String          @unique
  category AmenityCategory

  listings ListingAmenity[]
}

model ListingAmenity {
  listingId String
  amenityId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityId])
}

model ListingModeration {
  id        String                  @id @default(uuid())
  listingId String
  adminId   String
  action    ListingModerationAction
  reason    String?
  createdAt DateTime                @default(now()) @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  admin   Profile @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([listingId])
  @@index([adminId])
}

model Favorite {
  userId    String
  listingId String

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([userId, listingId])
}

model City {
  id        String   @id @default(uuid())
  name      String
  state     String?
  country   String?
  lat       Decimal  @db.Decimal(10, 8)
  lng       Decimal  @db.Decimal(11, 8)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([name, state, country])
  @@index([name])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  score     Int
  message   String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId, createdAt])
  @@index([userId])
}

enum UserRole {
  USER
  ADMIN
}

enum ListingStatus {
  PUBLISHED
  PAUSED
  PENDING
  REJECTED
}

enum ListingModerationAction {
  APPROVED
  REJECTED
}

enum PrivacyType {
  ENTIRE
  PRIVATE
  SHARED
}

enum PropertyType {
  HOUSE
  APARTMENT
  CABIN
  BOAT
}

enum AmenityCategory {
  GENERAL
  KITCHEN
  DINING
  BEDROOM
  BATHROOM
  ENTERTAINMENT
  SECURITY
  ACTIVITIES
}

enum ReservationStatus {
  UPCOMING
  COMPLETED
  CANCELED
  CANCELED_BY_HOST
}
